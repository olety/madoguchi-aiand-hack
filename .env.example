# Copy to .env and fill in. ai& is the brain; GLM 5.2 is the extraction model
# (Kimi K2.7 is unstable on ai& — swap AI_MODEL to any ai& model id at will).
# Direct to ai& (OpenAI-compatible) — no proxy.
AI_BASE_URL=https://api.aiand.com/v1
AI_API_KEY=sk-...your-aiand-key...
AI_MODEL=zai-org/glm-5.2

# Abort a hung upstream generation after this many ms, then retry.
AI_TIMEOUT_MS=45000

# Hono server port (Vite dev proxies /api -> here).
PORT=3000
