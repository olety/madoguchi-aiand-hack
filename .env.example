# Copy to .env and fill in. Kimi K2.7 via ai& is the only brain.
#
# Option A — direct to ai& (OpenAI-compatible):
#   AI_BASE_URL=https://api.aiand.com/v1
#   AI_API_KEY=sk-...your-aiand-key...
#   AI_MODEL=moonshotai/kimi-k2.7-code
#
# Option B — via the local CLIProxyAPI proxy (keeps the ai& key server-side):
AI_BASE_URL=http://127.0.0.1:8317/v1
AI_API_KEY=sk-local-...your-proxy-key...
AI_MODEL=kimi-k2.7-code

# Abort a hung upstream generation after this many ms, then retry.
AI_TIMEOUT_MS=45000

# Hono server port (Vite dev proxies /api -> here).
PORT=3000
